@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="kpi-card kpi-blue">
      <div class="kpi-icon"><i class="bi bi-file-earmark-text"></i></div>
      <div class="kpi-body">
        <span class="kpi-label">Total facturas</span>
        <span class="kpi-value">@Model.TotalInvoices</span>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
      <div class="kpi-body">
        <span class="kpi-label">Ingresos cobrados</span>
        <span class="kpi-value">@Model.TotalRevenue.ToString("C", new System.Globalization.CultureInfo("es-ES"))</span>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon"><i class="bi bi-clock-history"></i></div>
      <div class="kpi-body">
        <span class="kpi-label">Pendiente de cobro</span>
        <span class="kpi-value">@Model.PendingAmount.ToString("C", new System.Globalization.CultureInfo("es-ES"))</span>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="kpi-card kpi-red">
      <div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
      <div class="kpi-body">
        <span class="kpi-label">Vencidas</span>
        <span class="kpi-value">@Model.OverdueCount <small>(@Model.OverdueAmount.ToString("C", new System.Globalization.CultureInfo("es-ES")))</small></span>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Recent invoices -->
  <div class="col-lg-7">
    <div class="card-panel">
      <div class="panel-header">
        <h2 class="panel-title"><i class="bi bi-clock me-2"></i>Facturas recientes</h2>
        <a href="@Url.Action("Index","Invoices")" class="btn-link-small">Ver todas →</a>
      </div>
      <div class="table-responsive">
        <table class="table im-table">
          <thead>
            <tr>
              <th>Número</th>
              <th>Cliente</th>
              <th>Total</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var inv in Model.RecentInvoices)
            {
              <tr onclick="location.href='@Url.Action("Details","Invoices",new{id=inv.Id})'" style="cursor:pointer">
                <td><span class="inv-number">@inv.Number</span></td>
                <td>@inv.Client?.Name</td>
                <td>@inv.Total.ToString("C", new System.Globalization.CultureInfo("es-ES"))</td>
                <td><span class="status-badge status-@inv.Status.ToString().ToLower()">@InvoicesController.StatusLabel(inv.Status)</span></td>
              </tr>
            }
            @if (!Model.RecentInvoices.Any())
            {
              <tr><td colspan="4" class="text-center text-muted py-4">Sin facturas aún. <a href="@Url.Action("Create","Invoices")">Crea la primera</a>.</td></tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Sidebar panel -->
  <div class="col-lg-5">
    <!-- Stats -->
    <div class="card-panel mb-4">
      <div class="panel-header">
        <h2 class="panel-title"><i class="bi bi-pie-chart me-2"></i>Resumen de estados</h2>
      </div>
      <div class="status-summary">
        <div class="status-row">
          <span class="status-badge status-pending">Pendiente</span>
          <div class="status-bar-wrap">
            @{ var total = Math.Max(Model.TotalInvoices, 1); }
            <div class="status-bar" style="width:@((Model.PendingCount * 100 / total))%"></div>
          </div>
          <span class="status-count">@Model.PendingCount</span>
        </div>
        <div class="status-row">
          <span class="status-badge status-paid">Pagado</span>
          <div class="status-bar-wrap">
            <div class="status-bar bar-paid" style="width:@((Model.PaidCount * 100 / total))%"></div>
          </div>
          <span class="status-count">@Model.PaidCount</span>
        </div>
        <div class="status-row">
          <span class="status-badge status-overdue">Vencido</span>
          <div class="status-bar-wrap">
            <div class="status-bar bar-overdue" style="width:@((Model.OverdueCount * 100 / total))%"></div>
          </div>
          <span class="status-count">@Model.OverdueCount</span>
        </div>
      </div>
    </div>

    <!-- Overdue alerts -->
    @if (Model.OverdueInvoices.Any())
    {
      <div class="card-panel panel-danger">
        <div class="panel-header">
          <h2 class="panel-title"><i class="bi bi-alarm me-2"></i>Atención — vencidas</h2>
        </div>
        @foreach (var inv in Model.OverdueInvoices.Take(4))
        {
          <div class="overdue-item">
            <div>
              <div class="inv-number">@inv.Number</div>
              <div class="overdue-client">@inv.Client?.Name</div>
            </div>
            <div class="text-end">
              <div class="overdue-amount">@inv.Total.ToString("C", new System.Globalization.CultureInfo("es-ES"))</div>
              <div class="overdue-days">hace @((DateTime.Today - inv.DueDate).Days) días</div>
            </div>
          </div>
        }
        <a href="@Url.Action("Index","Invoices", new{status="Overdue"})" class="btn btn-sm btn-outline-danger w-100 mt-2">Ver todas las vencidas</a>
      </div>
    }
    else
    {
      <div class="card-panel text-center py-4">
        <i class="bi bi-check-circle-fill text-success fs-2 mb-2 d-block"></i>
        <p class="text-muted mb-0">¡Sin facturas vencidas! Todo al día.</p>
      </div>
    }
  </div>
</div>
