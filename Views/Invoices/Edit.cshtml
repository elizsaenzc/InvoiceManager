@model Invoice
@{
    ViewData["Title"] = Model.IsDraft ? "Editar borrador" : $"Editar {Model.Number}";
}
<div class="page-head">
  <div>
    <a href="@Url.Action("Details", new { id = Model.Id })" class="back-link"><i class="bi bi-chevron-left"></i>@Model.DisplayNumber</a>
    <h1 class="page-title">@(Model.IsDraft ? "Editar borrador" : $"Editar {Model.Number}")</h1>
  </div>
  @Fmt.Pill(Model.Status, true)
</div>
<partial name="_InvoiceForm" model="Model" />
