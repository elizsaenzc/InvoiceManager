@model Tuple<InvoiceLine, int>
@{
    var line = Model.Item1;
    var idx  = Model.Item2;
}
<div class="line-row lines-grid" data-line>
  <input type="hidden" name="Lines[@idx].Id" value="@line.Id" />
  <div>
    <input type="text"
           name="Lines[@idx].Description"
           value="@line.Description"
           class="form-control"
           placeholder="Descripción del servicio o producto"
           data-line-desc />
  </div>
  <div>
    <input type="number"
           name="Lines[@idx].Quantity"
           value="@line.Quantity"
           class="form-control text-center"
           min="0.01" step="0.01"
           data-line-qty />
  </div>
  <div>
    <input type="number"
           name="Lines[@idx].UnitPrice"
           value="@line.UnitPrice"
           class="form-control text-end"
           min="0" step="0.01"
           placeholder="0,00"
           data-line-price />
  </div>
  <div class="d-flex align-items-center justify-content-end">
    <span class="line-total" data-line-total>0,00 €</span>
  </div>
  <div class="d-flex align-items-center justify-content-center">
    <button type="button" class="btn btn-icon text-danger" data-remove-line title="Eliminar línea">
      <i class="bi bi-trash"></i>
    </button>
  </div>
</div>
