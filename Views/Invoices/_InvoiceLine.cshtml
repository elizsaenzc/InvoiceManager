@model Tuple<InvoiceLine, string>
@{
    var line = Model.Item1;
    var idx = Model.Item2;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var empty = string.IsNullOrEmpty(line.Description) && line.UnitPrice == 0;
}
<div class="line-row lines-grid" data-line>
  <div>
    <input type="text" name="Lines[@idx].Description" value="@line.Description" class="form-control"
           placeholder="Concepto o servicio" list="concepts" maxlength="300" autocomplete="off" data-line-desc aria-label="Concepto" />
  </div>
  <div>
    <input type="number" name="Lines[@idx].Quantity" value="@line.Quantity.ToString("0.##", inv)" class="form-control text-center"
           min="0.01" step="0.01" data-line-qty aria-label="Cantidad" />
  </div>
  <div>
    <input type="number" name="Lines[@idx].UnitPrice" value="@(empty ? "" : line.UnitPrice.ToString("0.00", inv))" class="form-control text-end"
           min="0" step="0.01" placeholder="0,00" data-line-price aria-label="Precio unitario" />
  </div>
  <div class="line-total" data-line-total>0,00 €</div>
  <div class="text-center">
    <button type="button" class="btn btn-icon" data-remove-line title="Quitar concepto" aria-label="Quitar concepto"><i class="bi bi-dash-lg"></i></button>
  </div>
</div>
