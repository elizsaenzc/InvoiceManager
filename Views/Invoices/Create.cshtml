@model Invoice
@{
    ViewData["Title"] = "Nueva factura";
}
<div class="page-head">
  <div>
    <a href="@Url.Action("Index")" class="back-link"><i class="bi bi-chevron-left"></i>Facturas</a>
    <h1 class="page-title">Nueva factura</h1>
    @if (ViewBag.CopyOf is string copy)
    {
      <div class="page-sub">Copia de @copy con fecha de hoy</div>
    }
  </div>
</div>
<partial name="_InvoiceForm" model="Model" />
