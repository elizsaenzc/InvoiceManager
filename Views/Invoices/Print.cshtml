@model Invoice
@using Microsoft.Extensions.Options
@inject IOptions<CompanyOptions> CompanyOpt
@{
    Layout = null;
    var company = CompanyOpt.Value;
    var c = Model.Client!;
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Factura @Model.DisplayNumber · @c.Name</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, Arial, sans-serif; font-size: 12.5px; color: #1c1c1e; background: #e5e5ea; -webkit-font-smoothing: antialiased; }
    .sheet { background: #fff; width: 210mm; min-height: 297mm; margin: 24px auto 96px; padding: 18mm 18mm 16mm; display: flex; flex-direction: column; box-shadow: 0 4px 30px rgba(0,0,0,.12); }
    .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .logo { display: flex; align-items: center; gap: 12px; }
    .mark { width: 44px; height: 44px; border-radius: 11px; background: #007aff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .co-name { font-size: 18px; font-weight: 700; letter-spacing: -.02em; }
    .co-sub { color: #6e6e73; line-height: 1.6; margin-top: 10px; }
    .doc { text-align: right; }
    .doc-type { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #8a8a8e; }
    .doc-no { font-size: 24px; font-weight: 700; letter-spacing: -.01em; margin-top: 2px; }
    .stamp { display: inline-block; margin-top: 8px; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .stamp.paid { background: #e3f7e8; color: #1f8a3c; }
    .stamp.cancelled { background: #ffe5e3; color: #d70015; }
    .stamp.draft { background: #f2f2f7; color: #3c3c43; }

    .meta { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 24px; margin: 34px 0 28px; padding: 18px 20px; background: #f6f6f8; border-radius: 12px; }
    .label { font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #8a8a8e; margin-bottom: 4px; }
    .strong { font-weight: 600; font-size: 13.5px; }
    .muted { color: #6e6e73; line-height: 1.6; }

    table { width: 100%; border-collapse: collapse; }
    thead th { font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #8a8a8e; text-align: left; padding: 0 8px 10px; border-bottom: 1px solid #d1d1d6; }
    tbody td { padding: 12px 8px; border-bottom: 1px solid #ececf0; vertical-align: top; }
    .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .totals { margin-left: auto; width: 280px; margin-top: 18px; }
    .totals .row { display: flex; justify-content: space-between; padding: 5px 8px; font-variant-numeric: tabular-nums; color: #3c3c43; }
    .totals .grand { margin-top: 6px; padding: 12px 8px; border-top: 2px solid #1c1c1e; font-size: 17px; font-weight: 700; color: #1c1c1e; }

    .notes { margin-top: 26px; padding: 14px 16px; border-radius: 10px; background: #f6f6f8; white-space: pre-line; color: #3c3c43; }
    .pay { margin-top: 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .iban { font-size: 14px; font-weight: 600; letter-spacing: .02em; font-variant-numeric: tabular-nums; }
    .foot { margin-top: auto; padding-top: 24px; border-top: 1px solid #ececf0; font-size: 10px; color: #8a8a8e; line-height: 1.6; }

    .bar { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); display: flex; gap: 10px; padding: 8px; border-radius: 16px; background: rgba(255,255,255,.85); backdrop-filter: blur(20px); box-shadow: 0 8px 30px rgba(0,0,0,.18); }
    .bar button { font: inherit; font-size: 15px; font-weight: 600; border: 0; border-radius: 10px; padding: 9px 18px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
    .bar .primary { background: #007aff; color: #fff; }
    .bar .gray { background: rgba(118,118,128,.12); color: #1c1c1e; }

    @@page { size: A4; margin: 0; }
    @@media print {
      body { background: #fff; }
      .sheet { margin: 0; box-shadow: none; width: auto; min-height: 297mm; }
      .bar { display: none; }
    }
    @@media (max-width: 820px) {
      .sheet { width: auto; min-height: 0; margin: 0 0 90px; padding: 24px 18px; box-shadow: none; }
      .meta, .pay { grid-template-columns: 1fr; }
      .top { flex-direction: column; }
      .doc { text-align: left; }
    }
  </style>
</head>
<body>
<div class="sheet">
  <div class="top">
    <div>
      <div class="logo"><span class="mark"><i class="bi bi-receipt"></i></span><span class="co-name">@company.Name</span></div>
      <div class="co-sub">
        NIF @company.TaxId<br />
        @company.Address · @company.City<br />
        @company.Phone · @company.Email
      </div>
    </div>
    <div class="doc">
      <div class="doc-type">@(Model.IsDraft ? "Borrador" : "Factura")</div>
      <div class="doc-no">@Model.DisplayNumber</div>
      @if (Model.Status == InvoiceStatus.Paid) { <span class="stamp paid">Cobrada el @Fmt.Date(Model.PaidDate!.Value)</span> }
      @if (Model.Status == InvoiceStatus.Cancelled) { <span class="stamp cancelled">Anulada</span> }
      @if (Model.IsDraft) { <span class="stamp draft">Sin validez fiscal</span> }
    </div>
  </div>

  <div class="meta">
    <div>
      <div class="label">Facturar a</div>
      <div class="strong">@c.Name</div>
      <div class="muted">
        @if (!string.IsNullOrEmpty(c.TaxId)) { <span>NIF @c.TaxId<br /></span> }
        @if (!string.IsNullOrEmpty(c.Address)) { <span>@c.Address<br /></span> }
        @if (!string.IsNullOrEmpty(c.City)) { <span>@c.City</span> }
      </div>
    </div>
    <div>
      <div class="label">Fecha de emisión</div>
      <div class="strong">@Fmt.DateLong(Model.IssueDate)</div>
    </div>
    <div>
      <div class="label">Vencimiento</div>
      <div class="strong">@Fmt.DateLong(Model.DueDate)</div>
    </div>
  </div>

  <table>
    <thead>
      <tr><th>Concepto</th><th class="r">Cantidad</th><th class="r">Precio</th><th class="r">Importe</th></tr>
    </thead>
    <tbody>
      @foreach (var l in Model.Lines)
      {
        <tr>
          <td>@l.Description</td>
          <td class="r">@Fmt.Num(l.Quantity)</td>
          <td class="r">@Fmt.Eur(l.UnitPrice)</td>
          <td class="r">@Fmt.Eur(l.Total)</td>
        </tr>
      }
    </tbody>
  </table>

  <div class="totals">
    <div class="row"><span>Base imponible</span><span>@Fmt.Eur(Model.Subtotal)</span></div>
    <div class="row"><span>IVA @Fmt.Pct(Model.TaxRate)</span><span>@Fmt.Eur(Model.TaxAmount)</span></div>
    <div class="row grand"><span>Total</span><span>@Fmt.Eur(Model.Total)</span></div>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Notes))
  {
    <div class="notes">@Model.Notes</div>
  }

  <div class="pay">
    <div>
      <div class="label">Forma de pago</div>
      <div class="muted">Transferencia bancaria indicando el número de factura</div>
      <div class="iban">@company.Iban</div>
    </div>
    <div>
      <div class="label">Contacto</div>
      <div class="muted">@company.Email<br />@company.Web</div>
    </div>
  </div>

  <div class="foot">
    @company.Name · NIF @company.TaxId · @company.Registry.<br />
    En cumplimiento del RGPD, los datos del cliente se tratan únicamente para la gestión de la relación comercial y la facturación.
  </div>
</div>

<div class="bar">
  <button class="gray" onclick="history.length > 1 ? history.back() : window.close()"><i class="bi bi-chevron-left"></i>Volver</button>
  <button class="primary" onclick="window.print()"><i class="bi bi-printer"></i>Imprimir o guardar PDF</button>
</div>
</body>
</html>
