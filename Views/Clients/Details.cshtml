@model ClientDetailsViewModel
@{
    var c = Model.Client;
    ViewData["Title"] = c.Name;
}

<div class="page-head">
  <div>
    <a href="@Url.Action("Index")" class="back-link"><i class="bi bi-chevron-left"></i>Clientes</a>
    <h1 class="page-title">@c.Name</h1>
    <div class="page-sub">Cliente desde @c.CreatedAt.ToLocalTime().ToString("MMMM 'de' yyyy", Fmt.Es)</div>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Edit", new { id = c.Id })" class="btn btn-gray"><i class="bi bi-pencil"></i>Editar</a>
    <a href="@Url.Action("Create", "Invoices", new { clientId = c.Id })" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Nueva factura</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card-ios kpi"><span class="app-ico lg bg-blue"><i class="bi bi-receipt"></i></span><div><div class="kpi-label">Facturado</div><div class="kpi-value">@Fmt.EurShort(Model.Invoiced)</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card-ios kpi"><span class="app-ico lg bg-green"><i class="bi bi-wallet2"></i></span><div><div class="kpi-label">Cobrado</div><div class="kpi-value">@Fmt.EurShort(Model.Collected)</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card-ios kpi"><span class="app-ico lg @(Model.Overdue > 0 ? "bg-red" : "bg-orange")"><i class="bi bi-hourglass-split"></i></span><div><div class="kpi-label">Pendiente</div><div class="kpi-value">@Fmt.EurShort(Model.Outstanding)</div>@if (Model.Overdue > 0) {<div class="kpi-sub due-late">@Fmt.Eur(Model.Overdue) vencido</div>}</div></div></div>
  <div class="col-6 col-xl-3"><div class="card-ios kpi"><span class="app-ico lg bg-purple"><i class="bi bi-stopwatch"></i></span><div><div class="kpi-label">Cobro medio</div><div class="kpi-value">@(Model.AverageCollectionDays is int d ? $"{d} días" : "—")</div><div class="kpi-sub">Plazo pactado: @(c.PaymentTermsDays == 0 ? "contado" : $"{c.PaymentTermsDays} días")</div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-xl-4">
    <div class="section-title">Datos fiscales y contacto</div>
    <div class="card-ios card-pad mb-3">
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="avatar lg @Fmt.AvatarTone(c.Id)">@c.Initials</span>
        <div><div class="fw-600">@c.Name</div><div class="small-2 muted">@(c.TaxId is null ? "Sin NIF" : "NIF " + c.TaxId)</div></div>
      </div>
      @if (!string.IsNullOrEmpty(c.ContactName)) { <div class="info-row"><i class="bi bi-person"></i>@c.ContactName</div> }
      <div class="info-row"><i class="bi bi-envelope"></i><a href="mailto:@c.Email">@c.Email</a></div>
      @if (!string.IsNullOrEmpty(c.Phone)) { <div class="info-row"><i class="bi bi-telephone"></i><a href="tel:@c.Phone.Replace(" ", "")">@c.Phone</a></div> }
      @if (!string.IsNullOrEmpty(c.Address) || !string.IsNullOrEmpty(c.City)) { <div class="info-row"><i class="bi bi-geo-alt"></i><span>@c.Address<br />@c.City</span></div> }
    </div>
    @if (!Model.Invoices.Any())
    {
      <form asp-action="Delete" asp-route-id="@c.Id" method="post"
            data-confirm="Se eliminará el cliente. No tiene facturas asociadas." data-confirm-title="¿Eliminar cliente?" data-confirm-ok="Eliminar" data-confirm-danger>
        <button class="btn btn-danger-tinted w-100"><i class="bi bi-trash"></i>Eliminar cliente</button>
      </form>
    }
  </div>

  <div class="col-xl-8">
    <div class="section-title">Facturas</div>
    <div class="card-ios">
      @if (!Model.Invoices.Any())
      {
        <div class="empty"><i class="bi bi-file-earmark-text"></i>Este cliente todavía no tiene facturas.</div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table-ios">
            <thead><tr><th>Número</th><th class="hide-sm">Concepto</th><th class="hide-sm">Fecha</th><th class="num">Total</th><th>Estado</th></tr></thead>
            <tbody>
              @foreach (var inv in Model.Invoices)
              {
                <tr class="link" data-href="@Url.Action("Details", "Invoices", new { id = inv.Id })">
                  <td><span class="inv-no @(inv.IsDraft ? "draft" : "")">@inv.DisplayNumber</span></td>
                  <td class="hide-sm"><div class="text-truncate small-2" style="max-width:300px">@inv.Lines.FirstOrDefault()?.Description</div></td>
                  <td class="hide-sm muted tnum">@Fmt.Date(inv.IssueDate)</td>
                  <td class="num fw-600">@Fmt.Eur(inv.Total)</td>
                  <td>@Fmt.Pill(inv.Status)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>
</div>
