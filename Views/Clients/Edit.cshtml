@model Client
@{
    ViewData["Title"] = $"Editar {Model.Name}";
}
<div class="page-head">
  <div>
    <a href="@Url.Action("Details", new { id = Model.Id })" class="back-link"><i class="bi bi-chevron-left"></i>@Model.Name</a>
    <h1 class="page-title">Editar cliente</h1>
  </div>
</div>
<partial name="_ClientForm" model="Model" />
