@model Client
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card-panel">
      <h2 class="section-heading mb-4">Datos del cliente</h2>
      <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
          <div class="col-12">
            <label asp-for="Name" class="form-label">Nombre / Empresa *</label>
            <input asp-for="Name" class="form-control" placeholder="Acme Corp S.L." />
            <span asp-validation-for="Name" class="text-danger small"></span>
          </div>
          <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email *</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
          </div>
          <div class="col-md-6">
            <label asp-for="TaxId" class="form-label">NIF / CIF</label>
            <input asp-for="TaxId" class="form-control" placeholder="B12345678" />
          </div>
          <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Teléfono</label>
            <input asp-for="Phone" class="form-control" placeholder="+34 91 000 0000" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
          </div>
          <div class="col-12">
            <label asp-for="Address" class="form-label">Dirección</label>
            <input asp-for="Address" class="form-control" />
          </div>
        </div>
        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary">Guardar cliente</button>
          <a href="@Url.Action("Index")" class="btn btn-ghost">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
